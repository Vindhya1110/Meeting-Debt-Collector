# ── LLM: Groq (fast path — extraction/resolution/agenda/nudges, OpenAI compatible) ──
# Used for everything on the live/frequent path, where low latency matters:
# extraction, resolution, agenda matching (every ~30s chunk), nudge and
# reassignment message generation.
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ── LLM: Featherless (one-shot path — MoM/pattern report/pre-brief, OpenAI compatible) ──
# Used only for end-of-meeting / occasional generation, where Featherless's
# slower serverless latency doesn't hurt: MoM, pattern report, pre-brief.
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Note: the "official" meta-llama/* model IDs are gated behind HuggingFace org
# verification on most Featherless accounts. These unsloth mirrors are the same
# weights, un-gated. Switch back to meta-llama/* if your account gets verified.
FEATHERLESS_MODEL_MAIN=unsloth/Meta-Llama-3.1-70B-Instruct
FEATHERLESS_MODEL_FAST=unsloth/Meta-Llama-3.1-8B-Instruct

# ── Notion (ALL reports go here) ──────────────────────────────────────────────
NOTION_TOKEN=your_notion_integration_token
# A blank Notion PAGE, shared with your integration (••• -> Connections).
# The agent auto-creates 4 databases under this page on first run.
NOTION_PARENT_PAGE_ID=your_parent_page_id

# These are AUTO-CREATED by the agent on first run — leave blank
NOTION_COMMITMENTS_DB_ID=
NOTION_MEETINGS_DB_ID=
NOTION_PEOPLE_DB_ID=
NOTION_AGENDA_DB_ID=

# ── Notifications ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Calendar (optional; path relative to agent/ working dir) ──────────────────
GOOGLE_CALENDAR_CREDS=credentials.json

# ── Similarity engine (duplicate/renegotiate/recommit detection) ──────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Agent behaviour ───────────────────────────────────────────────────────────
MOCK_MODE=false
AGENT_PORT=8000
WATCH_INTERVAL_SECONDS=10
NUDGE_HOURS_BEFORE=24
ESCALATE_HOURS_BEFORE=6
QUIET_HOURS_START=22
QUIET_HOURS_END=8
EXAM_MODE=false
