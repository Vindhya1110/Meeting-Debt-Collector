# LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Task structuring
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DB_ID=your_notion_database_id_here

# Nudge delivery
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# Calendar (path to downloaded credentials.json, relative to backend/ working dir)
GOOGLE_CALENDAR_CREDS=credentials.json

# Embeddings (used by similarity.py for duplicate/renegotiation detection)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Demo control
MOCK_MODE=false
